entity User {
  table "users"

  field id: i64 {
    primary
    auto_increment
  }

  field email: string {
    unique
    not_empty
    max_len 320
  }

  field name: string {
    not_empty
    max_len 120
  }

  field active: bool {
    default true
  }

  field created_at: i64 {
    immutable
    default now_millis
  }

  edge pets {
    to Pet
  }

  edge To("groups", Group.Type).Through("memberships", Membership.Type) {
  }

  edge To("reports", User.Type).From("manager").Unique() {
  }

  edge To("friends", User.Type).Through("friendships", Friendship.Type) {
  }

  edge From("friended_by", User.Type).Ref("friends").Through("friendships", Friendship.Type) {
  }
}

entity Pet {
  table "pets"

  field id: i64 {
    primary
    auto_increment
  }

  field owner_id: i64 {
  }

  field name: string {
    not_empty
    max_len 120
  }

  field species: string {
    enum cat, dog, other
  }

  edge owner {
    to User
    field owner_id
    ref id
    unique
    required
  }
}

entity Group {
  table "groups"

  field id: i64 {
    primary
    auto_increment
  }

  field name: string {
    unique
    not_empty
    max_len 120
  }

  field description: string? {
    max_len 500
  }

  field created_at: i64 {
    immutable
    default now_millis
  }

  edge From("users", User.Type).Ref("groups").Through("memberships", Membership.Type) {
  }
}

entity Membership {
  table "memberships"

  field id: i64 {
    primary
    auto_increment
  }

  field user_id: i64 {
  }

  field group_id: i64 {
  }

  field role: string {
    default "member"
    enum member, admin
  }

  field joined_at: i64 {
    immutable
    default now_millis
  }

  edge To("user", User.Type).Field("user_id").Ref("id").Unique().Required() {
  }

  edge To("group", Group.Type).Field("group_id").Ref("id").Unique().Required() {
  }

  index uniq_membership {
    fields user_id, group_id
    unique
  }
}

entity Friendship {
  table "friendships"

  field id: i64 {
    primary
    auto_increment
  }

  field user_id: i64 {
  }

  field friend_id: i64 {
  }

  field created_at: i64 {
    immutable
    default now_millis
  }

  edge To("user", User.Type).Field("user_id").Ref("id").Unique().Required() {
  }

  edge To("friend", User.Type).Field("friend_id").Ref("id").Unique().Required() {
  }

  index uniq_friendship {
    fields user_id, friend_id
    unique
  }
}

entity Project {
  table "projects"
  tenant tenant_id
  soft_delete deleted_at

  field id: i64 {
    primary
    auto_increment
  }

  field tenant_id: string {
    immutable
    not_empty
    max_len 64
  }

  field name: string {
    not_empty
    max_len 120
  }

  field description: string? {
    max_len 500
  }

  field version: i64 {
    default 1
    positive
  }

  field deleted_at: i64? {
  }

  field created_at: i64 {
    immutable
    default now_millis
  }

  field updated_at: i64 {
    default now_millis
    update_default now_millis
  }

  index uniq_project_tenant_name {
    fields tenant_id, name
    unique
  }
}

entity ScalarFixture {
  table "scalar_fixtures"

  field id: string {
    primary
    not_empty
    max_len 64
  }

  field external_id: uuid {
    unique
  }

  field small_value: i16 {
  }

  field int_value: i32 {
  }

  field big_value: i64 {
  }

  field float_value: f32 {
  }

  field double_value: f64 {
  }

  field payload: bytes? {
  }

  field metadata: json {
  }

  field amount: decimal {
  }

  field local_time: timestamp {
  }

  field event_time: timestamptz? {
  }
}

entity LocaleSetting {
  table "locale_settings"
  primary tenant_id, locale

  field tenant_id: string {
    immutable
    not_empty
    max_len 64
  }

  field locale: string {
    immutable
    not_empty
    max_len 32
  }

  field value: string {
    max_len 500
  }
}

entity AuditEvent {
  table "audit_events"
  schema "roze_ent"
  cache_key id

  field id: i64 {
    primary
    auto_increment
  }

  field user_id: i64 {
  }

  field action: string {
    not_empty
    max_len 120
  }

  field created_at: i64 {
    immutable
    default "now_millis"
  }

  index idx_audit_events_user_id {
    fields user_id
  }

  edge user {
    to User
    field user_id
    ref id
    unique
    required
  }
}
