+fn sea_orm_active_primary_key_expr(model: &ModelSpec, active_ident: &str) -> String {
+    let values = model
+        .primary_fields
+        .iter()
+        .map(|name| {
+            format!(
+                "{active_ident}.{}.clone().unwrap()",
+                model_field_ident_by_name(name)
+            )
+        })
+        .collect::<Vec<_>>();
+    if values.len() == 1 {
+        values[0].clone()
+    } else {
+        format!("({})", values.join(", "))
+    }
