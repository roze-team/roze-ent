syntax = "v1"

info (
    title: "Roze Ent API"
    desc: "Rust-native entity and graph API generated by Roze"
)

@server (
    prefix: /api/v1
    group: entities
)

service roze-ent {
    @permission users:write
    @handler createUser
    post /users (CreateUserReq) returns (UserResp)
    @permission users:read
    @handler getUser
    get /users/:id (GetUserReq) returns (UserResp)
    @permission users:read
    @handler listUsers
    get /users (EmptyReq) returns (ListUsersResp)
    @permission users:write
    @handler deleteUser
    delete /users/:id (GetUserReq) returns (DeleteResp)
    @permission pets:write
    @handler createPet
    post /pets (CreatePetReq) returns (PetResp)
    @permission pets:read
    @handler getPet
    get /pets/:id (GetPetReq) returns (PetResp)
    @permission pets:read
    @handler listUserPets
    get /users/:id/pets (GetUserReq) returns (ListPetsResp)
    @permission pets:write
    @handler deletePet
    delete /pets/:id (GetPetReq) returns (DeleteResp)
    @permission groups:write
    @handler createGroup
    post /groups (CreateGroupReq) returns (GroupResp)
    @permission groups:read
    @handler getGroup
    get /groups/:id (GetGroupReq) returns (GroupResp)
    @permission groups:read
    @handler listGroups
    get /groups (EmptyReq) returns (ListGroupsResp)
    @permission groups:write
    @handler addGroupMember
    post /groups/:group_id/members/:user_id (MembershipPathReq) returns (MembershipResp)
    @permission groups:write
    @handler updateGroupMember
    patch /groups/:group_id/members/:user_id (UpdateMembershipRoleReq) returns (MembershipResp)
    @permission groups:write
    @handler removeGroupMember
    delete /groups/:group_id/members/:user_id (MembershipPathReq) returns (DeleteResp)
    @permission groups:read
    @handler listGroupUsers
    get /groups/:id/users (GetGroupReq) returns (ListUsersResp)
    @permission groups:read
    @handler listUserGroups
    get /users/:id/groups (GetUserReq) returns (ListGroupsResp)
    @permission projects:write
    @handler createProject
    post /projects (CreateProjectReq) returns (ProjectResp)
    @permission projects:read
    @handler getProject
    get /projects/:id (ProjectPathReq) returns (ProjectResp)
    @permission projects:read
    @handler listProjects
    get /projects (ListProjectsReq) returns (ListProjectsResp)
    @permission projects:write
    @handler updateProject
    patch /projects/:id (UpdateProjectReq) returns (ProjectResp)
    @permission projects:write
    @handler deleteProject
    delete /projects/:id (ProjectPathReq) returns (DeleteResp)
}

type (
    CreateUserReq {
        email string `json:"email" validate:"required,email,max=320"`
        name string `json:"name" validate:"required,min=1,max=120"`
    }
    GetUserReq {
        id i64 `path:"id" validate:"min=1"`
    }
    UserResp {
        id i64 `json:"id"`
        email string `json:"email"`
        name string `json:"name"`
        active bool `json:"active"`
        createdAt i64 `json:"created_at"`
    }
    ListUsersResp {
        users []UserResp `json:"users"`
    }
    CreatePetReq {
        ownerId i64 `json:"owner_id" validate:"min=1"`
        name string `json:"name" validate:"required,min=1,max=120"`
        species string `json:"species" validate:"required,oneof=cat dog other"`
    }
    GetPetReq {
        id i64 `path:"id" validate:"min=1"`
    }
    PetResp {
        id i64 `json:"id"`
        ownerId i64 `json:"owner_id"`
        name string `json:"name"`
        species string `json:"species"`
    }
    ListPetsResp {
        pets []PetResp `json:"pets"`
    }
    DeleteResp {
        deleted bool `json:"deleted"`
    }
    CreateGroupReq {
        name string `json:"name" validate:"required,min=1,max=120"`
        description Option<String> `json:"description" validate:"optional,max=500"`
    }
    GetGroupReq {
        id i64 `path:"id" validate:"min=1"`
    }
    GroupResp {
        id i64 `json:"id"`
        name string `json:"name"`
        description Option<String> `json:"description"`
        createdAt i64 `json:"created_at"`
    }
    ListGroupsResp {
        groups []GroupResp `json:"groups"`
    }
    MembershipPathReq {
        groupId i64 `path:"group_id" validate:"min=1"`
        userId i64 `path:"user_id" validate:"min=1"`
    }
    UpdateMembershipRoleReq {
        groupId i64 `path:"group_id" validate:"min=1"`
        userId i64 `path:"user_id" validate:"min=1"`
        expectedRole string `json:"expected_role" validate:"required,oneof=member admin"`
        role string `json:"role" validate:"required,oneof=member admin"`
    }
    MembershipResp {
        id i64 `json:"id"`
        userId i64 `json:"user_id"`
        groupId i64 `json:"group_id"`
        role string `json:"role"`
        joinedAt i64 `json:"joined_at"`
    }
    CreateProjectReq {
        tenantId String `header:"x-tenant-id" validate:"required,max=64"`
        name string `json:"name" validate:"required,min=1,max=120"`
        description Option<String> `json:"description" validate:"optional,max=500"`
    }
    ProjectPathReq {
        id i64 `path:"id" validate:"min=1"`
        tenantId String `header:"x-tenant-id" validate:"required,max=64"`
    }
    ListProjectsReq {
        tenantId String `header:"x-tenant-id" validate:"required,max=64"`
    }
    UpdateProjectReq {
        id i64 `path:"id" validate:"min=1"`
        tenantId String `header:"x-tenant-id" validate:"required,max=64"`
        expectedVersion i64 `json:"expected_version" validate:"min=1"`
        name string `json:"name" validate:"required,min=1,max=120"`
        description Option<String> `json:"description" validate:"optional,max=500"`
    }
    ProjectResp {
        id i64 `json:"id"`
        tenantId String `json:"tenant_id"`
        name string `json:"name"`
        description Option<String> `json:"description"`
        version i64 `json:"version"`
        deletedAt Option<i64> `json:"deleted_at"`
        createdAt i64 `json:"created_at"`
        updatedAt i64 `json:"updated_at"`
    }
    ListProjectsResp {
        projects []ProjectResp `json:"projects"`
    }
    EmptyReq {
    }
)
